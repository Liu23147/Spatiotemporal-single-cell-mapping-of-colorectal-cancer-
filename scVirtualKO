
res9 <- scVirtualKO(scRNA1 , ko_gene = "FPR1", mode = c('Receptor'),manual_background_genes = my_background  ,
                            n_targets = 1000, 
                            n_trees = 2000,
                            seed = 123,
                            verbose = TRUE, 
                            nichenet_mat = niche_mat,  
                            ppi_source = ppi_source ,
                            lr_net = niche_net,
                            candidate_genes = NULL)
genes_to_show <- c(		
  'CXCL9','CXCL10','CXCL11',	
  'TIMP3',	
  'NLRP3',	'EREG','THBS1',	
  'ZEB2','IRAK3','AQP9','AREG')

library(ggplot2)
library(ggrepel)
library(dplyr)
plot_data <- res8 %>%
  mutate(
    
    
    Direction = factor(ifelse(Delta_Mean > 0, "Positive (Red)", "Negative (Blue)"),
                       levels = c("Negative (Blue)", "Positive (Red)")),
    
    
    Label = ifelse(Gene %in% genes_to_show, Gene, NA),
    
    
    Point_Size = ifelse(Gene %in% genes_to_show, 3.5, 1.5),
    
    
    Point_Alpha = ifelse(Gene %in% genes_to_show, 1.0, 0.6)
  )


p <- ggplot(plot_data, aes(x = Delta_Mean, y = Hybrid_Score)) +
  
  
  geom_vline(xintercept = 0, linetype = "dashed", color = "grey50", size = 0.5) +
  
  
  geom_point(aes(color = Direction, size = Point_Size, alpha = Point_Alpha)) +
  
  
  scale_color_manual(values = c("Negative (Blue)" = "#377EB8",
                                "Positive (Red)" = "#E41A1C")) + 
  
  
  scale_size_identity() +
  scale_alpha_identity() +

geom_text_repel(
  data = subset(plot_data, !is.na(Label) & Delta_Mean <= 0),
  aes(label = Label),
  xlim = c(-Inf, -0.001),  
  direction = "y",         
  box.padding = 0.5,
  point.padding = 0.3,
  max.overlaps = Inf,
  min.segment.length = 0,
  color = "#377EB8",       
  fontface = "bold",
  segment.color = "grey60"
) +
  
  
  geom_text_repel(
    data = subset(plot_data, !is.na(Label) & Delta_Mean > 0), 
    aes(label = Label),
    xlim = c(0.001, Inf),   
    direction = "y",       
    box.padding = 0.5,
    point.padding = 0.3,
    max.overlaps = Inf,
    min.segment.length = 0,
    color = "#E41A1C",     
    fontface = "bold",
    segment.color = "grey60"
  ) +
  
  
  labs(title = "Virtual KO Analysis: Hybrid Score vs. Predicted Change",
       subtitle = paste0("Highlighting selected ", length(genes_to_show), " genes"),
       x = "Predicted Change (Delta Mean)\n(Left: Upregulated in KO | Right: Downregulated in KO)",
       y = "Hybrid Score (Magnitude & Evidence)",
       color = "Change Direction") +
  
  theme_bw() +
  theme(
    plot.title = element_text(face = "bold", size = 14, hjust = 0.5),
    legend.position = "top",
    panel.grid.minor = element_blank()
  )
print(p)
